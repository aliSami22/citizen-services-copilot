# Environment variables — copy to `.env` or set per-shell. NO real secrets here.
# ASP.NET Core convention: colon ":" is written as "__" in env var names.

# --- PostgreSQL / pgvector ---
ConnectionStrings__DefaultConnection=Host=localhost;Port=5432;Database=citizenservices;Username=postgres;Password=CHANGE_ME

# --- LLM / embeddings provider: "Ollama" (default, no key) or "OpenAI" ---
LlmSettings__Provider=Ollama
LlmSettings__DefaultModel=gpt-4o-mini

# OpenAI (only needed when Provider=OpenAI)
LlmSettings__OpenAI__ApiKey=
LlmSettings__OpenAI__BaseUrl=https://api.openai.com/v1
LlmSettings__OpenAI__CheapModel=gpt-4o-mini
LlmSettings__OpenAI__ExpensiveModel=gpt-4o
LlmSettings__OpenAI__EmbeddingModel=text-embedding-3-small

# Ollama
LlmSettings__Ollama__BaseUrl=http://localhost:11434
LlmSettings__Ollama__CheapModel=llama3.2:1b
LlmSettings__Ollama__ExpensiveModel=llama3.1:8b
LlmSettings__Ollama__EmbeddingModel=nomic-embed-text

# --- JWT (must be >= 32 bytes in production) ---
Jwt__Key=dev-only-key-replace-in-production-0123456789abcdef
Jwt__Issuer=CitizenServicesCopilot
Jwt__Audience=CitizenServicesCopilot.Api

# --- Workflow orchestrator (multi-agent) ---
Orchestrator__Routing__CheapModel=gpt-4o-mini
Orchestrator__Routing__PremiumModel=gpt-4o
Orchestrator__MaxIterations=6
Orchestrator__StepTimeout=00:00:30
Orchestrator__RetryAttempts=2
Orchestrator__RetryBaseDelayMs=500
Orchestrator__RetryBackoffFactor=2
Orchestrator__EnableGracefulDegradation=true
Orchestrator__ApprovalPollingInterval=00:00:00.500
Orchestrator__ApprovalWaitTimeout=00:05:00

# --- Logging / host ---
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning
AllowedHosts=*